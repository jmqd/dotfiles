#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
	exit 0
fi

cd "$repo_root"

has_strict_mode() {
	local file="$1"

	if grep -Eq '^[[:space:]]*set[[:space:]]+-[^#]*e[^#]*u[^#]*o[^#]*[[:space:]]+pipefail' "$file"; then
		return 0
	fi

	if grep -Eq '^[[:space:]]*set[[:space:]]+-o[[:space:]]+errexit' "$file" &&
		grep -Eq '^[[:space:]]*set[[:space:]]+-o[[:space:]]+nounset' "$file" &&
		grep -Eq '^[[:space:]]*set[[:space:]]+-o[[:space:]]+pipefail' "$file"; then
		return 0
	fi

	# House style (rustup-init.sh): POSIX sh with `set -u`, explicit
	# ensure/err failure paths, and a final `main "$@" || exit 1` so a
	# truncated script runs nothing.
	if grep -Eq '^[[:space:]]*set[[:space:]]+-u[[:space:]]*$' "$file" &&
		[ "$(tail -n 1 "$file")" = 'main "$@" || exit 1' ]; then
		return 0
	fi

	return 1
}

detect_shell() {
	local file="$1"

	case "$file" in
	*.bash | .bashrc)
		echo "bash"
		return 0
		;;
	*.zsh | .zshrc)
		echo "zsh"
		return 0
		;;
	esac

	if head -n 1 "$file" | grep -q 'bash'; then
		echo "bash"
	elif head -n 1 "$file" | grep -q 'zsh'; then
		echo "zsh"
	else
		echo "sh"
	fi
}

# Extensionless scripts under bin/ count when their shebang names a shell.
has_shell_shebang() {
	head -n 1 "$1" 2>/dev/null | grep -Eq '^#!.*[/ ](ba|z)?sh([[:space:]]|$)'
}

shell_files=()
while IFS= read -r -d '' file; do
	case "$file" in
	*.sh | *.bash | *.zsh | .bashrc | .zshrc | .githooks/pre-push)
		shell_files+=("$file")
		;;
	bin/*)
		if has_shell_shebang "$file"; then
			shell_files+=("$file")
		fi
		;;
	esac
done < <(git ls-files -z)

failed=0

# Runs shellcheck over the given files, one process per file in parallel.
# Returns non-zero when a file fails or shellcheck cannot be run.
run_shellcheck() {
	local shell_name="$1"
	shift

	if command -v shellcheck >/dev/null 2>&1; then
		printf '%s\0' "$@" | xargs -0 -n 1 -P "$jobs" shellcheck -x -s "$shell_name"
		return
	fi

	if command -v nix >/dev/null 2>&1 && [ -f "$repo_root/flake.nix" ]; then
		local tmp_cache_dir status=0
		tmp_cache_dir="$(mktemp -d)"
		XDG_CACHE_HOME="$tmp_cache_dir" nix develop --quiet --no-write-lock-file --command shellcheck -x -s "$shell_name" "$@" || status=$?
		rm -rf "$tmp_cache_dir"
		return "$status"
	fi

	echo "pre-push: shellcheck unavailable (install it or enable nix)" >&2
	return 1
}

jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
bash_files=()
sh_files=()

if [ "${#shell_files[@]}" -eq 0 ]; then
	echo "pre-push: no shell files found; skipping shell checks"
else
	echo "pre-push: running shell checks"

	for file in "${shell_files[@]}"; do
		[ -f "$file" ] || continue

		shell_name="$(detect_shell "$file")"

		case "$shell_name" in
		bash)
			if ! bash -n "$file"; then
				echo "pre-push: syntax check failed for $file (bash)" >&2
				failed=1
			fi
			bash_files+=("$file")
			;;
		zsh)
			if command -v zsh >/dev/null 2>&1; then
				if ! zsh -n "$file"; then
					echo "pre-push: syntax check failed for $file (zsh)" >&2
					failed=1
				fi
			else
				echo "pre-push: WARN zsh not found; skipped syntax check for $file"
			fi
			echo "pre-push: WARN ShellCheck does not support zsh; skipped for $file"
			;;
		*)
			if ! sh -n "$file"; then
				echo "pre-push: syntax check failed for $file (sh)" >&2
				failed=1
			fi
			sh_files+=("$file")
			;;
		esac

		case "$file" in
		bin/*.sh | .githooks/pre-push)
			if ! has_strict_mode "$file"; then
				echo "pre-push: $file missing strict mode (set -euo pipefail, or set -u ending in main \"\$@\" || exit 1)" >&2
				failed=1
			fi
			;;
		esac
	done

	if [ "${#bash_files[@]}" -gt 0 ] && ! run_shellcheck bash "${bash_files[@]}"; then
		echo "pre-push: shellcheck failed for bash scripts" >&2
		failed=1
	fi
	if [ "${#sh_files[@]}" -gt 0 ] && ! run_shellcheck sh "${sh_files[@]}"; then
		echo "pre-push: shellcheck failed for sh scripts" >&2
		failed=1
	fi
fi

echo "pre-push: running secret scan"
if ! bin/lint-secrets.sh; then
	echo "pre-push: secret scan failed" >&2
	failed=1
fi

# Git passes the remote name as the first argument. Commits already on that
# remote are published, so only the rest need a scan. Without a plainly
# named, configured remote (a URL, or a manual run), scan every local ref.
remote_name="${1:-}"
if [[ "$remote_name" =~ ^[A-Za-z0-9._/-]+$ ]] && git remote | grep -Fxq -- "$remote_name"; then
	echo "pre-push: scanning commits not yet on $remote_name"
	history_scan=(bin/lint-secrets.sh --unpushed "$remote_name")
else
	echo "pre-push: scanning committed history across local refs"
	history_scan=(bin/lint-secrets.sh --history)
fi
if ! "${history_scan[@]}"; then
	echo "pre-push: committed secret scan failed" >&2
	failed=1
fi

if [ "$failed" -ne 0 ]; then
	echo "pre-push: checks failed" >&2
	exit 1
fi

echo "pre-push: all checks passed"
