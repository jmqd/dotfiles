#!/usr/bin/env bash
set -euo pipefail

# Emacs resolves symlinks in --load paths, so a loader file cannot locate the
# Home Manager-linked config. Hand Emacs the config directory itself instead.
resolve_init_directory() {
  local configured_dir repo_root repo_dir

  configured_dir="${EMACS_HANDCRAFTED_INIT_DIRECTORY:-${HOME}/.emacs.d}"
  if [[ -f "${configured_dir}/init.el" ]]; then
    printf '%s\n' "${configured_dir}"
    return 0
  fi

  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  repo_dir="${repo_root}/emacs"
  if [[ -f "${repo_dir}/init.el" ]]; then
    printf '%s\n' "${repo_dir}"
    return 0
  fi

  echo "No handcrafted init directory found. Checked ${configured_dir} and ${repo_dir}." >&2
  return 1
}

init_directory="$(resolve_init_directory)"
emacs_bin="${EMACS_HANDCRAFTED_EMACS_BIN:-${EMACS:-}}"

if [[ -z "${emacs_bin}" ]]; then
  emacs_bin="$(command -v emacs || true)"
fi

if [[ -z "${emacs_bin}" ]]; then
  echo "No Emacs binary found. Set EMACS_HANDCRAFTED_EMACS_BIN or install the Home Manager Emacs package." >&2
  exit 1
fi

exec "${emacs_bin}" --init-directory="${init_directory}" "$@"
